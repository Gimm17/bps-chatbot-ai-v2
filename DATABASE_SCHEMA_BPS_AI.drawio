        <mxCell id="100" value="&lt;font style='font-size: 18px;'&gt;&lt;b&gt;ENTITY RELATIONSHIP DIAGRAM (ERD) &amp; DATABASE SCHEMA — BPS AI ASSISTANT V2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 12px; color: #64748B;'&gt;Struktur Tabel Percakapan, Feedback Pengguna, Indeks Publikasi PDF, Korpus Pengetahuan, dan Antrean Sistem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0093DD;strokeWidth=2;align=center;shadow=1;" vertex="1" parent="1">
