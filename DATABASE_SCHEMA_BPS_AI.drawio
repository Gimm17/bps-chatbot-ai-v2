        </mxCell>
        <mxCell id="2" value="&lt;b&gt;feedback&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Evaluasi &amp; Kepuasan Pengguna)&lt;/i&gt;&lt;hr&gt;
+ &lt;b&gt;id&lt;/b&gt; : BIGINT [PK, AutoInc]&lt;br&gt;
* &lt;b&gt;request_id&lt;/b&gt; : VARCHAR(255) [INDEX, Nullable]&lt;br&gt;
* &lt;b&gt;rating&lt;/b&gt; : VARCHAR(20) [helpful, not_helpful]&lt;br&gt;
o &lt;b&gt;comment&lt;/b&gt; : TEXT [Nullable]&lt;br&gt;
* &lt;b&gt;created_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;
* &lt;b&gt;updated_at&lt;/b&gt; : TIMESTAMP" style="shape=swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FEF6EB;strokeColor=#EB891B;fontColor=#1F2937;align=left;" vertex="1" parent="1">
