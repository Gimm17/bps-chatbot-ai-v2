        <mxCell id="100" value="&lt;font style='font-size: 18px;'&gt;&lt;b&gt;FLOWCHART ARSITEKTUR &amp; ALUR KERJA END-TO-END — BPS AI ASSISTANT V2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 12px; color: #64748B;'&gt;Diagram Alur Komputasi dari Input Pengguna, Guardrails, WebAPI / PPID RAG, Wrapping LLM, hingga Rendering Jawaban&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0093DD;strokeWidth=2;align=center;shadow=1;" vertex="1" parent="1">
