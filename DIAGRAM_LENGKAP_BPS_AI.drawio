        <mxCell id="30" value="&lt;b&gt;UC-11: Monitoring Telemetri &amp; Log Sesi&lt;/b&gt;&lt;br&gt;(Evaluasi Kualitas Respons &amp; Akurasi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="720" width="280" height="60"/>
