        <mxCell id="26" value="&lt;b&gt;&lt;&lt;include&gt;&gt; Filter Keamanan ScopeGuard&lt;/b&gt;&lt;br&gt;(Prompt Injection, Sapaan, Scope)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F0F9EA;strokeColor=#68B92E;fontColor=#1F2937;fontStyle=0;dashed=1;" vertex="1" parent="1">
