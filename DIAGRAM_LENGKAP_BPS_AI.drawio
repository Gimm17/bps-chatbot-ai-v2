        <mxCell id="27" value="&lt;b&gt;&lt;&lt;include&gt;&gt; Tarik Data WebAPI / PPID&lt;/b&gt;&lt;br&gt;(Domain Resolver &amp; Citation Binding)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F0F9EA;strokeColor=#68B92E;fontColor=#1F2937;fontStyle=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="330" width="280" height="60"/>
        </mxCell>
        <mxCell id="28" value="&lt;b&gt;&lt;&lt;include&gt;&gt; Sintesis Jawaban LLM&lt;/b&gt;&lt;br&gt;(Multi-Key OpenRouter Failover)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F0F9EA;strokeColor=#68B92E;fontColor=#1F2937;fontStyle=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="460" width="280" height="60"/>
        </mxCell>
        <mxCell id="29" value="&lt;b&gt;&lt;&lt;extend&gt;&gt; Ekstraksi PDF Asinkron&lt;/b&gt;&lt;br&gt;(IngestPublicationJob Background)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF6EB;strokeColor=#EB891B;fontColor=#1F2937;fontStyle=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="600" width="280" height="60"/>
