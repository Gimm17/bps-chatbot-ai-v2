        <mxCell id="25" value="&lt;b&gt;UC-06: Memberikan Feedback Respons&lt;/b&gt;&lt;br&gt;(Helpful / Not Helpful Rating)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EBF7FD;strokeColor=#0093DD;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1">
