        <mxCell id="31" value="&lt;b&gt;UC-12: Pembaruan Korpus PPID &amp; Pejabat&lt;/b&gt;&lt;br&gt;(Update Pejabat Struktural Baru)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1">
